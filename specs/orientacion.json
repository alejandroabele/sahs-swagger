{
  "openapi": "3.0.3",
  "info": {
    "title": "Orientación Service",
    "version": "1.0.0",
    "description": "Provee una API para gestionar las orientaciones, y las áreas y materias que las componen.\n\n**Modelos del dominio:** Orientación, Área, Materia.\n\nConvenciones: una ruta por función; `POST` para commands y `GET` para queries; el id de la entidad principal va en la ruta y el resto de los datos en el body. Los datos relacionados de un solo elemento vienen anidados en la entidad.\n\n> No hay backend detrás de este contrato: el servidor es ilustrativo y \"Try it out\" no va a obtener respuesta.\n\n**Dependencias (Invokes):**\n- `profesor_suplencias.get_profesor` → usado por: `get_profesores_materia`, `get_profesores_area`, `get_area`\n- `planificacion.get_clase` → usado por: `asignar_clase_a_materia`\n- `planificacion.get_curso` → usado por: `asignar_curso_a_orientacion`\n- `planificacion.get_anio_academico` → usado por: `asignar_anio_academico_a_materia`",
    "x-dependencias": [
      {
        "servicio": "profesor_suplencias",
        "endpoint": "get_profesor",
        "usado_por": [
          "get_profesores_materia",
          "get_profesores_area",
          "get_area"
        ]
      },
      {
        "servicio": "planificacion",
        "endpoint": "get_clase",
        "usado_por": [
          "asignar_clase_a_materia"
        ]
      },
      {
        "servicio": "planificacion",
        "endpoint": "get_curso",
        "usado_por": [
          "asignar_curso_a_orientacion"
        ]
      },
      {
        "servicio": "planificacion",
        "endpoint": "get_anio_academico",
        "usado_por": [
          "asignar_anio_academico_a_materia"
        ]
      }
    ]
  },
  "servers": [
    {
      "url": "http://localhost:8085",
      "description": "Servidor ilustrativo (sin backend)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Estado del servicio"
    },
    {
      "name": "Orientación",
      "description": "Orientaciones (planes de estudio)"
    },
    {
      "name": "Área",
      "description": "Áreas que agrupan materias"
    },
    {
      "name": "Materia",
      "description": "Materias"
    }
  ],
  "paths": {
    "/actuator/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "health",
        "summary": "Health check del servicio",
        "responses": {
          "200": {
            "description": "Servicio disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/orientacion/crear_materia": {
      "post": {
        "tags": [
          "Materia"
        ],
        "operationId": "crear_materia",
        "summary": "Crear materia",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre_materia": {
                    "type": "string",
                    "example": "Matemática"
                  },
                  "descripcion_materia": {
                    "type": "string",
                    "example": "Matemática de 1° año"
                  },
                  "horas_semanales": {
                    "type": "integer",
                    "format": "int64",
                    "example": 5
                  },
                  "id_area": {
                    "type": "integer",
                    "format": "int64",
                    "nullable": true,
                    "example": 1
                  },
                  "id_orientacion": {
                    "type": "integer",
                    "format": "int64",
                    "example": 2
                  },
                  "id_anio_academico": {
                    "type": "integer",
                    "format": "int64",
                    "example": 1
                  }
                },
                "required": [
                  "nombre_materia",
                  "horas_semanales",
                  "id_orientacion"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Materia"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
